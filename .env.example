# Local development example. Vercel must use a managed PostgreSQL connection URL;
# localhost on Vercel cannot reach the developer's computer.
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/personal_data_management_dev"

# Generate a unique high-entropy value with at least 32 characters for each environment.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Local development URL. In Vercel Production, use the canonical HTTPS site URL.
BETTER_AUTH_URL="http://localhost:3000"
